{
  "name": "ns-simulator",
  "version": "1.0.0",
  "description": "A browser-based system design simulator",
  "author": "example.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "vite",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run typecheck && vite build",
    "preview": "vite preview",
    "check:web-bundle-budget": "node scripts/check-web-bundle-budget.mjs",
    "audit:question-authoring": "tsx scripts/audit-question-authoring-coverage.ts",
    "generate:django-guides": "tsx scripts/generate-django-admin-assignment-guides.ts",
    "package:simulator-question-author": "bash scripts/package-skill.sh simulator-question-author",
    "validate:question-bank": "tsx scripts/validate-question-dir.ts ns-simulator-docs/examples/question-bank/*",
    "migration:snapshot": "tsx scripts/compute-contention-migration.ts snapshot",
    "migration:diff": "tsx scripts/compute-contention-migration.ts diff",
    "test": "vitest run --root .",
    "test:perf": "RUN_PERF_TESTS=true vitest run --root .",
    "simulate": "tsx src/cli/index.ts",
    "sim": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react-resizable-panels": "^3.0.6",
    "reactflow": "^11.11.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^22.19.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.1.6",
    "vitest": "^4.1.0"
  }
}
