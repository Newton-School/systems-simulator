{
  "id": "edge-connections-and-batching",
  "name": "Edge connections: TLS, HTTP/2, WebSocket and Kafka batching",
  "version": "1.0.0",
  "global": {
    "simulationDuration": 10000,
    "seed": "edge-connections-seed",
    "warmupDuration": 1000,
    "timeResolution": "microsecond",
    "defaultTimeout": 3000
  },
  "nodes": [
    {
      "id": "clients",
      "type": "api-endpoint",
      "category": "compute",
      "role": "source",
      "label": "Chat Clients",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "ws-gateway",
      "type": "websockets-gateway",
      "category": "network-and-edge",
      "label": "WebSocket Gateway",
      "position": {
        "x": 320,
        "y": 0
      },
      "queue": {
        "workers": 256,
        "capacity": 50000,
        "discipline": "fifo"
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 0.2
        },
        "timeout": 5000
      }
    },
    {
      "id": "chat-svc",
      "type": "microservice",
      "category": "compute",
      "label": "Chat Service",
      "position": {
        "x": 640,
        "y": 0
      },
      "queue": {
        "workers": 256,
        "capacity": 50000,
        "discipline": "fifo"
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 1
        },
        "timeout": 5000
      }
    },
    {
      "id": "profile-api",
      "type": "microservice",
      "category": "compute",
      "label": "Profile API",
      "position": {
        "x": 960,
        "y": 0
      },
      "queue": {
        "workers": 256,
        "capacity": 50000,
        "discipline": "fifo"
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 20
        },
        "timeout": 5000
      }
    },
    {
      "id": "events",
      "type": "stream",
      "category": "messaging-and-streaming",
      "label": "Chat Events (Kafka)",
      "position": {
        "x": 960,
        "y": 200
      },
      "queue": {
        "workers": 256,
        "capacity": 50000,
        "discipline": "fifo"
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 0.2
        },
        "timeout": 5000
      }
    }
  ],
  "edges": [
    {
      "id": "clients->ws-gateway",
      "source": "clients",
      "target": "ws-gateway",
      "mode": "streaming",
      "protocol": "websocket",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 40
        },
        "pathType": "internet"
      },
      "bandwidth": 10000,
      "maxConcurrentRequests": 10000,
      "packetLossRate": 0,
      "errorRate": 0,
      "connection": {
        "reuse": "persistent",
        "tls": "1.3"
      }
    },
    {
      "id": "ws-gateway->chat-svc",
      "source": "ws-gateway",
      "target": "chat-svc",
      "mode": "synchronous",
      "protocol": "grpc",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 10000,
      "maxConcurrentRequests": 10000,
      "packetLossRate": 0,
      "errorRate": 0,
      "connection": {
        "reuse": "keep-alive",
        "maxConnections": 2
      }
    },
    {
      "id": "chat-svc->profile-api",
      "source": "chat-svc",
      "target": "profile-api",
      "mode": "synchronous",
      "protocol": "https",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 2
        },
        "pathType": "cross-zone"
      },
      "bandwidth": 10000,
      "maxConcurrentRequests": 10000,
      "packetLossRate": 0,
      "errorRate": 0,
      "connection": {
        "reuse": "keep-alive",
        "tls": "1.2",
        "tlsSessionResumption": true,
        "maxConnections": 4,
        "idleTimeoutMs": 30000
      }
    },
    {
      "id": "chat-svc->events",
      "source": "chat-svc",
      "target": "events",
      "mode": "asynchronous",
      "protocol": "kafka",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 1
        },
        "pathType": "same-dc"
      },
      "bandwidth": 10000,
      "maxConcurrentRequests": 5,
      "packetLossRate": 0,
      "errorRate": 0,
      "batching": {
        "lingerMs": 10,
        "maxBatchBytes": 16384
      }
    }
  ],
  "workload": {
    "sourceNodeId": "clients",
    "pattern": "poisson",
    "baseRps": 150,
    "requestDistribution": [
      {
        "type": "chat-message",
        "weight": 1,
        "sizeBytes": 300,
        "keyspace": {
          "field": "sessionId",
          "size": 500
        }
      }
    ]
  }
}
