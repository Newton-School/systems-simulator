{
  "id": "{{SLUG}}-solution",
  "name": "{{TITLE}} — Reference Solution",
  "version": "2.1.0",
  "global": {
    "simulationDuration": 5000,
    "warmupDuration": 0,
    "seed": "{{SLUG}}-v1",
    "timeResolution": "microsecond",
    "defaultTimeout": 5000,
    "traceSampleRate": 0.01
  },
  "nodes": [
    {
      "id": "source",
      "type": "api-endpoint",
      "category": "compute",
      "role": "source",
      "label": "Traffic Source",
      "position": { "x": 80, "y": 300 }
    },
    {
      "id": "router",
      "type": "load-balancer-l7",
      "category": "network-and-edge",
      "role": "router",
      "label": "Load Balancer L7",
      "position": { "x": 460, "y": 300 },
      "config": { "routingStrategy": "round-robin" }
    },
    {
      "id": "service-1",
      "type": "microservice",
      "category": "compute",
      "role": "processor",
      "label": "Service 1",
      "position": { "x": 840, "y": 300 },
      "config": {
        "capacityRps": 100000,
        "capacityAuthored": true
      }
    }
  ],
  "edges": [
    {
      "id": "source-to-router",
      "source": "source",
      "target": "router",
      "mode": "synchronous",
      "protocol": "https",
      "latency": { "distribution": { "type": "constant", "value": 1 }, "pathType": "same-dc" },
      "bandwidth": 100000,
      "maxConcurrentRequests": 2000000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "router-to-service-1",
      "source": "router",
      "target": "service-1",
      "mode": "synchronous",
      "protocol": "https",
      "latency": { "distribution": { "type": "constant", "value": 1 }, "pathType": "same-dc" },
      "bandwidth": 100000,
      "maxConcurrentRequests": 2000000,
      "packetLossRate": 0,
      "errorRate": 0
    }
  ],
  "workload": {
    "sourceNodeId": "source",
    "pattern": "constant",
    "baseRps": 1000000,
    "requestDistribution": [{ "type": "read", "weight": 1, "sizeBytes": 100 }]
  }
}
