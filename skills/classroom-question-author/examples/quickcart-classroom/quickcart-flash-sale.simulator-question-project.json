  "question": {
    "id": "quickcart-flash-sale",
    "title": "QuickCart Flash Sale",
    "description": "Scale a stateless request tier behind a load balancer to carry a 1,000,000 req/s flash sale while  keeping every server within an 80% capacity headroom budget.",
    "tags": [],
    "author": "Hritvik Mohan",
    "createdAt": "2026-09-21T00:00:00.000Z",
    "setup": {
      "difficulty": "beginner",
      "type": "scaling",
      "entryFormat": "blank-canvas",
      "domains": ["compute"],
      "concepts": ["horizontal-scaling", "capacity-headroom", "load-balancing"],
      "workloadCategory": "read-heavy",
      "estimatedTimeMinutes": 10,
      "passThreshold": 1,
      "suiteVisibleToStudent": false,
      "constraints": {
        "allowedNodeTypes": ["microservice", "api-endpoint", "load-balancer"],
        "canModifyScaffold": true,
        "canRemoveScaffoldNodes": true
      },
      "classroom": {
        "givens": {
          "microservice": {
            "label": "Server",
            "capacityRps": 100000,
            "costPerHour": 0.192
          }
        },
        "targets": {
          "maxUtilization": 0.8,
          "maxErrorRate": 0.01
        },
        "objectives": [
          {
            "id": "request-path",
            "statement": "The student can route incoming traffic through a load balancer.",
            "concept": "NET-05"
          },
          {
            "id": "capacity-planning",
            "statement": "The student can choose enough server copies to serve peak traffic with headroom.",
            "concept": "SC-05"
          }
        ],
        "controls": [
          {
            "id": "place-users",
            "kind": "place-component",
            "label": "Place the users entry point",
            "component": "api-endpoint",
            "objectiveId": "request-path"
          },
          {
            "id": "place-load-balancer",
            "kind": "place-component",
            "label": "Place the load balancer",
            "component": "load-balancer",
            "objectiveId": "request-path"
          },
          {
            "id": "connect-request-path",
            "kind": "connect-components",
            "label": "Connect the request path",
            "objectiveId": "request-path"
          },
          {
            "id": "place-servers",
            "kind": "place-component",
            "label": "Place the server fleet",
            "component": "microservice",
            "objectiveId": "capacity-planning"
          },
          {
            "id": "scale-servers",
            "kind": "copies",
            "label": "Choose the number of server copies",
            "component": "microservice",
            "objectiveId": "capacity-planning"
          }
        ],
        "checks": [
          {
            "id": "through-lb",
            "template": "traffic-flows-through",
            "via": "load-balancer",
            "component": "microservice",
            "label": "All traffic reaches the servers through the load balancer",
            "objectiveId": "request-path"
          },
          {
            "id": "serves-all",
            "template": "serves-all-traffic",
            "label": "Every request is served",
            "objectiveId": "capacity-planning"
          },
          {
            "id": "headroom",
            "template": "within-target-utilization",
            "component": "microservice",
            "label": "Every server stays at or below 80% utilization",
            "points": 2,
            "objectiveId": "capacity-planning"
          },
          {
            "id": "right-size",
            "template": "right-sized",
            "component": "microservice",
            "factor": 1.5,
            "severity": "feedback",
            "label": "The fleet isn't much bigger than it needs to be"
          }
        ]
      }
    },
    "prompt": {
      "text": "You are the backend architect for an e-commerce website called QuickCart.\n\nQuickCart is running a major flash sale. During the sale, the website is expected to receive up to 1,000,000 requests per second.\n\nEach backend server can handle a maximum of 100,000 requests per second. To keep the servers stable, use no more than 80% of each server's capacity.\n\nThe load balancer distributes incoming requests evenly across every backend server you add.\n\nBuild the backend architecture for QuickCart from available components.",
      "scale": {
        "peakRps": 1000000,
        "readWriteRatio": 100
      },
      "functionalRequirements": [
        {
          "id": "fr-fee0ae1e-7078-4eea-854a-10492fc52362",
          "text": "Accept incoming user traffic through a load balancer."
        },
        {
          "id": "fr-641fe22d-4023-4453-b1b4-e30ea24b5aa6",
          "text": "Distribute traffic evenly across a pool of backend servers."
        },
        {
          "id": "fr-c7b07710-7e6f-4986-9175-e2a3e1404d01",
          "text": "Serve the full offered load without dropping requests."
        }
      ],
      "nonFunctionalRequirements": [
        {
          "id": "nfr-d3998a98-c959-4b7b-9e14-48162c425f02",
          "metric": "throughput",
          "operator": ">=",
          "value": 1000000,
          "unit": "req_per_sec"
        },
        {
          "id": "nfr-f46e38fa-1ed7-46ba-9f9f-42d4e3b6d03c",
          "metric": "error_rate",
          "operator": "<",
          "value": 1,
          "unit": "percent"
        }
      ]
    },
    "dryRunCase": {
      "id": "public-dry-run",
      "description": "Try the public flash-sale workload before submitting; hidden grading thresholds are evaluated separately.",
      "global": {
        "simulationDuration": 5000,
        "seed": "quickcart-flash-sale-v1",
        "warmupDuration": 0
      },
      "workload": {
        "pattern": "constant",
        "baseRps": 1000000,
        "requestDistribution": [
