        "burstDurationSeconds": 10,
        "normalDurationSeconds": 20,
        "spikeTimeSeconds": 20,
        "spikeRps": 5000,
        "spikeDurationSeconds": 10,
        "sawtoothPeakRps": 3000,
        "rampDurationSeconds": 20,
        "diurnalPeakMultiplier": 2,
        "keyspaceField": "",
        "keyspaceSize": null,
        "keyspaceSkew": null,
        "faults": [],
        "invariants": [
          {
            "id": "headroom-80",
            "description": "No server may exceed 80% of its capacity during the sale",
            "condition": "perNode.maxUtilization <= 0.8"
          }
        ]
      }
    ],
    "structuralRules": [
      {
        "id": "requires-load-balancer",
        "description": "Include a load balancer; either the L4 or L7 subtype is accepted.",
        "kind": "requires_component",
        "componentType": "load-balancer",
        "minCount": 1
      },
      {
        "id": "requires-api-server",
        "description": "Include at least one backend API server.",
        "kind": "requires_component",
        "componentType": "microservice",
        "minCount": 1
      },
      {
        "id": "requires-single-source",
        "description": "Use exactly one traffic source.",
        "kind": "requires_single_source"
      },
      {
        "id": "requires-source-to-balancer",
        "description": "Connect the traffic source directly to the load balancer.",
        "kind": "requires_edge",
        "fromType": "api-endpoint",
        "toType": "load-balancer"
      },
      {
        "id": "requires-balancer-to-server",
        "description": "Connect the load balancer directly to the backend server pool.",
        "kind": "requires_edge",
        "fromType": "load-balancer",
        "toType": "microservice"
      },
      {
        "id": "requires-connected-design",
        "description": "Every node must be reachable (no orphans).",
        "kind": "requires_connected_graph"
      }
    ],
    "semanticRules": [],
    "metricRules": [
      {
        "id": "metric-target",
        "description": "Keep errors under 1%: drop virtually no requests during the sale.",
        "metric": "error_rate",
        "operator": "<",
        "value": 1,
        "unit": "percent"
      }
    ],
    "rubricChecks": [
      {
        "id": "rubric-check-1",
        "description": "Serve the full flash-sale load: total throughput reaches 1,000,000 req/s.",
        "metric": "summary.throughput",
        "op": ">=",
        "value": 1000000,
        "points": 1
      },
      {
        "id": "rubric-check-2",
        "description": "Stay within the headroom budget: no server runs above 80% of its capacity.",
        "metric": "invariantViolations.count",
        "op": "==",
        "value": 0,
        "points": 2
      }
    ]
  },
