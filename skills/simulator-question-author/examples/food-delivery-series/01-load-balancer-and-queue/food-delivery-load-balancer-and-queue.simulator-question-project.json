  "question": {
    "id": "food-delivery-load-balancer-and-queue",
    "title": "Food Delivery Load Balancer and Queue",
    "description": "Design a horizontally scalable order intake path that buffers overload and retains orders while delivery partners are unavailable.",
    "tags": [],
    "author": "Hritvik Mohan",
    "createdAt": "2026-10-14T00:00:00.000Z",
    "setup": {
      "difficulty": "beginner",
      "type": "open-build",
      "entryFormat": "blank-canvas",
      "domains": ["compute"],
      "concepts": [
        "load-balancing",
        "horizontal-scaling",
        "queue-buffering",
        "asynchronous-processing"
      ],
      "workloadCategory": "correctness-heavy",
      "estimatedTimeMinutes": 20,
      "passThreshold": 1,
      "suiteVisibleToStudent": false,
      "constraints": {
        "allowedNodeTypes": [
          "api-endpoint",
          "load-balancer",
          "load-balancer-l7",
          "microservice",
          "queue",
          "batch-worker"
        ],
        "maxTotalWorkers": 1000,
        "canModifyScaffold": true,
        "canRemoveScaffoldNodes": true
      }
    },
    "prompt": {
      "text": "Design the high-level architecture for a food-delivery order-processing system receiving millions of orders per day. Multiple users place orders concurrently, application processing scales horizontally, peak traffic may create backlog, accepted orders must not be lost, and delivery assignment must wait when partners are unavailable.",
      "additionalContext": "The hidden run is a deterministic, scaled discrete proxy for the stated production workload. It grades supported simulator behavior, not cloud-provider guarantees.",
      "scale": {
        "dau": 5000000,
        "peakRps": 100,
        "storageGb": 10000,
        "growthRatePercent": 2
      },
      "functionalRequirements": [
        {
          "id": "fr-1",
          "text": "Spread incoming orders across at least two application servers behind a load balancer."
        },
        {
          "id": "fr-2",
          "text": "Hand orders from the application servers to a queue asynchronously."
        },
        {
          "id": "fr-3",
          "text": "Do not lose accepted orders when processing is overloaded."
        },
        {
          "id": "fr-4",
          "text": "Make orders wait for an available delivery partner instead of failing."
        }
      ],
      "nonFunctionalRequirements": []
    },
    "dryRunCase": {
      "id": "public-dry-run",
      "description": "A low-rate public run for checking connectivity and request flow.",
