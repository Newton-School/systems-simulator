    "structuralRules": [
      {
        "id": "single-source",
        "kind": "requires_single_source",
        "description": "Use exactly one traffic source."
      },
      {
        "id": "connected-graph",
        "kind": "requires_connected_graph",
        "description": "Keep every component connected to the architecture."
      },
      {
        "id": "two-app-servers",
        "kind": "requires_component",
        "description": "Run at least two application servers.",
        "componentType": "microservice",
        "minCount": 2
      },
      {
        "id": "async-order-handoff",
        "kind": "requires_edge",
        "description": "Send orders from an application server to the queue asynchronously.",
        "fromType": "microservice",
        "toType": "queue",
        "mode": "asynchronous"
      }
    ],
    "semanticRules": [
      {
        "id": "balancer-in-middle",
        "kind": "placement",
        "points": 1,
        "hardFail": true,
        "description": "Place the load balancer between incoming traffic and the application servers.",
        "componentType": "load-balancer",
        "betweenFrom": "api-endpoint",
        "betweenTo": "microservice"
      },
      {
        "id": "queue-feeds-worker",
        "kind": "placement",
        "points": 1,
        "hardFail": true,
        "description": "Place the queue between the order service and a background worker that consumes it.",
        "componentType": "queue",
        "betweenFrom": "microservice",
        "betweenTo": "batch-worker"
      }
    ],
    "metricRules": [],
    "rubricChecks": [
      {
        "id": "queue-no-loss",
