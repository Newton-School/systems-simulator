  },
  "rubric": {
    "version": "1.0",
    "id": "food-delivery-kafka-event-processing-rubric",
    "passThreshold": 1,
    "checks": [
      {
        "id": "groups-receive-events",
        "description": "Notifications, activity, and analytics must each receive events independently.",
        "kind": "simulation",
        "metric": "stream.groupsWithDeliveries",
        "op": ">=",
        "value": 3,
        "points": 3
      }
    ]
