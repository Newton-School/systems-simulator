                "clientId": "mobile-client",
                "partitionKey": "entity-3"
              }
            },
            {
              "type": "delivery-api",
              "weight": 0.2,
              "sizeBytes": 1024,
              "metadata": {
                "path": "/delivery",
                "authToken": "valid-token",
                "authStatus": "valid",
                "authScopes": ["api:access"],
                "clientId": "mobile-client",
                "partitionKey": "entity-4"
              }
            }
          ]
        }
      }
    ],
    "visibleToStudent": false,
    "dryRunCase": {
