          {
            "id": "invariant-1",
            "description": "No server may exceed 80% of its capacity during the scale.",
            "condition": "perNode.maxUtilization <= 0.8"
          }
        ]
      }
    ],
    "structuralRules": [
      {
        "id": "structural-rule-2",
        "description": "Include at least 1 load-balancer-l7.",
